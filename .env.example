# バスケットボール動画解析システム - 設定ファイル例
#
# このファイルをコピーして .env として使用してください：
#   cp .env.example .env
#
# 注意: .env は .gitignore に含まれており、Gitにコミットされません

# ============================================================================
# 動画設定
# ============================================================================

# デフォルト動画URL（オプション）
DEFAULT_VIDEO_URL=""

# デフォルト解析範囲（秒）
DEFAULT_START_TIME=0
DEFAULT_END_TIME=0

# ダウンロード解像度（480, 720, 1080）
VIDEO_RESOLUTION=720

# ============================================================================
# ボール検出設定
# ============================================================================

# オレンジ色検出範囲（HSV）
# H (色相): 0-180, S (彩度): 0-255, V (明度): 0-255

BALL_COLOR_H_MIN_1=0
BALL_COLOR_H_MAX_1=15
BALL_COLOR_S_MIN=100
BALL_COLOR_V_MIN=100

BALL_COLOR_H_MIN_2=160
BALL_COLOR_H_MAX_2=180

# 円検出パラメータ
HOUGH_MIN_RADIUS=5
HOUGH_MAX_RADIUS=50
HOUGH_MIN_DIST=30

# ============================================================================
# チーム識別設定
# ============================================================================

# 白チーム検出（HSV）
WHITE_TEAM_V_MIN=200
WHITE_TEAM_V_MAX=255
WHITE_TEAM_S_MIN=0
WHITE_TEAM_S_MAX=50

# 黒チーム検出（HSV）
BLACK_TEAM_V_MIN=0
BLACK_TEAM_V_MAX=50

# チーム識別閾値（0.0 - 1.0）
TEAM_DETECTION_THRESHOLD=0.1

# ============================================================================
# シュート判定設定
# ============================================================================

# リム半径倍率（成功判定）
RIM_MADE_THRESHOLD=0.8

# リム半径倍率（成功可能性判定）
RIM_POSSIBLE_THRESHOLD=1.5

# 最小軌道フレーム数
MIN_TRAJECTORY_FRAMES=5

# ============================================================================
# 出力設定
# ============================================================================

# 出力ディレクトリ
OUTPUT_DIR="outputs/private_analysis"

# 一時ファイル自動削除（true/false）
AUTO_DELETE_TEMP=false

# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL="INFO"

# ============================================================================
# パフォーマンス設定
# ============================================================================

# フレームスキップ（1=全フレーム解析、2=2フレームごと、等）
FRAME_SKIP=1

# 最大処理フレーム数（0=無制限）
MAX_FRAMES=0

# マルチスレッド処理（true/false）
USE_MULTITHREAD=false

# ============================================================================
# 高度な設定
# ============================================================================

# デバッグモード（中間画像を保存）
DEBUG_MODE=false

# 中間画像保存先
DEBUG_OUTPUT_DIR="outputs/debug"

# リム位置固定（空の場合は自動検出）
# 形式: "x,y,radius" 例: "320,180,15"
FIXED_RIM_POSITION=""

# カスタムチーム色（カンマ区切り）
# 形式: "team_name,h_min,h_max,s_min,s_max,v_min,v_max"
# 例: "red,0,10,100,255,100,255"
CUSTOM_TEAM_COLORS=""
